{
	"compilerOptions": {
		"target": "esnext",
		"module": "esnext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"types": ["node"],
		"verbatimModuleSyntax": true,
		"noUncheckedIndexedAccess": true
	},
	"include": ["src/**/*.ts", "test/**/*.ts"]
}
